 // Something (the Steam overlay, in UNI2 battles) can re-patch the Present slots after us. Put ours back and chain
 // to whatever it installed; nested calls go to the first original (see h_DevPresent).
+// MBTL-IM / UNI2-IM proxy dinput8.dll from the game folder (never the system one): its key and focus imports.
+static void hook_mod_proxy_iat() {
+	// MBTL only: UNI2-IM has its own in-process key injection (harness "keys"), which isolate_input would mask
+	static int is_mbtl = -1;
+	if (is_mbtl < 0) {
+		char exe[MAX_PATH] = {};
+		GetModuleFileNameA(nullptr, exe, MAX_PATH);
+		const char* b = strrchr(exe, '\\');
+		is_mbtl = _stricmp(b ? b + 1 : exe, "MBTL.exe") == 0;
+	}
+	if (!is_mbtl) return;
+	HMODULE m = GetModuleHandleA("dinput8.dll");
+	if (!m) return;
+	char path[MAX_PATH] = {};
+	GetModuleFileNameA(m, path, MAX_PATH);
+	for (char* c = path; *c; c++) *c = (char)tolower((unsigned char)*c);
+	if (strstr(path, "\\system32\\") || strstr(path, "\\syswow64\\")) return;
+	HMODULE u = GetModuleHandleA("user32.dll");
+	if (!o_GetForegroundWindow && u) o_GetForegroundWindow = (GetForegroundWindow_t)GetProcAddress(u, "GetForegroundWindow");
+	if (!o_GetAsyncKeyState && u) o_GetAsyncKeyState = (GetKeyState_t)GetProcAddress(u, "GetAsyncKeyState");
+	int a = hook_iat_in(m, "GetAsyncKeyState", (void*)o_GetAsyncKeyState, (void*)h_GetAsyncKeyState, nullptr);
+	int b = hook_iat_in(m, "GetForegroundWindow", (void*)o_GetForegroundWindow, (void*)h_GetForegroundWindow, nullptr);
+	if (a || b) logf("mod proxy %s: GetAsyncKeyState %d slot(s), GetForegroundWindow %d slot(s)", path, a, b);
+}
