# render-match2 round 3 (2026-10-15): chr020 unlit (aura RGB held 0) with the aura glow pass recorded in the sidecar
# (uni2_meta_aura.gcs: CharaAura_DrawGlow 0x59D910 colour/power/blend), idle control, the two CG cases and
# pras_chr020_p5f2, each with a same-session plate (hidefighters + one UNI2-IM step).
include ../games/uni2.gcs
let P1CHR 20
let P2CHR 0
include ../games/uni2_to_training.gcs
set OUTD C:\dev\hantei-chan\tools\gamecap\captures\v2
hold f32 [P1+0x8C0]+0x40 0
hold f32 [P1+0x8C0]+0x44 0
hold f32 [P1+0x8C0]+0x48 0
step 3
set CTRL ctrl_chr020_p0_r3
include ../games/uni2_v2_ctrl_plate.gcs
set CASE afhk_cg_chr020_p435_t27_r3
set PAT 435
set SETFRAME 0
set FRAME 0
set GTICK 28
set STEPKEYS F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6,F6
include ../games/uni2_v2_case_aura_plate.gcs
set CASE afhk_cg_chr020_p437_t2_r3
set PAT 437
set GTICK 3
set STEPKEYS F6,F6,F6
include ../games/uni2_v2_case_aura_plate.gcs
set CASE pras_chr020_p5f2_r3
set PAT 5
set SETFRAME 2
set FRAME 2
set GTICK 1
set STEPKEYS F6
include ../games/uni2_v2_case_aura_plate.gcs
quit
