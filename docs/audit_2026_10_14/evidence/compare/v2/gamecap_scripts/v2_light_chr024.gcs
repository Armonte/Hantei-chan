# render-match2 (2026-10-14): rect_chr024_p76 (shape type 2 line on the y axis) with a same-session plate and an idle
# control, lit (aura in the sidecar) and unlit (aura RGB held at 0).
include ../games/uni2.gcs
let P1CHR 24
let P2CHR 0
include ../games/uni2_to_training.gcs
set OUTD C:\dev\hantei-chan\tools\gamecap\captures\v2
set CTRL ctrl_chr024_p0_lit
include ../games/uni2_v2_ctrl_plate.gcs
set CASE rect_chr024_p76_lit
set PAT 76
set SETFRAME 0
set FRAME 0
set GTICK 1
set STEPKEYS F6
include ../games/uni2_v2_case_aura_plate.gcs
hold f32 [P1+0x8C0]+0x40 0
hold f32 [P1+0x8C0]+0x44 0
hold f32 [P1+0x8C0]+0x48 0
step 3
set CTRL ctrl_chr024_p0_unlit
include ../games/uni2_v2_ctrl_plate.gcs
set CASE rect_chr024_p76_unlit
include ../games/uni2_v2_case_aura_plate.gcs
quit
