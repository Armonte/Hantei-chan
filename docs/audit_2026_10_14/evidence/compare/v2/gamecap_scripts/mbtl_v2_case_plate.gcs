# MBTL v2 full-frame capture of one case (after mbtl_to_training.gcs, which leaves the game frozen by gamecap).
# MBTL-IM's own Pause (F5) / Next frame (F6) / hitbox overlay (F2), pressed with gamecap's virtual keys: the agent
# patches only the MBTL-IM proxy's GetAsyncKeyState/GetForegroundWindow imports (no focus change, no global input).
# MBTL-IM pauses by suppressing ticks, so MBTL's catch-up timer never runs a burst of updates (the drift of the old
# gamecap-freeze method). Shots: capture_window (PrintWindow of our HWND), clean and then with the hitbox overlay.
# Vars: CASE PAT SETFRAME FRAME GTICK NSTEPS OUTD
# render-match2: same-session backdrop plate. MBTL-IM "Hide the characters" (rebound to F9 by the case file, plain
# key so no Fn chord) toggled while still paused on the asserted frame -> ${CASE}_game_plate.png (+ _bb).
include mbtl.gcs
unfreeze
wait_frames 30
key_tap F5 3 10
wait_frames 10
peek i32 p1+OBJ_TICK tick_paused_a
wait_frames 10
peek i32 p1+OBJ_TICK tick_paused_b
call Object_SetPatternFrame ecx=p1 edx=${PAT} ${SETFRAME}
wait_frames 4
peek i32 p1+OBJ_PATTERN pat_after_set
peek i32 p1+OBJ_FRAME frame_after_set
peek i32 p1+OBJ_TICK tick_after_set
include mbtl_v2_steps_${NSTEPS}.gcs
wait_frames 6
peek i32 p1+OBJ_PATTERN pat_s
peek i32 p1+OBJ_FRAME frame_s
peek i32 p1+OBJ_TICK tick_s
assert_mem i32 p1+OBJ_PATTERN == ${PAT}
assert_mem i32 p1+OBJ_FRAME == ${FRAME}
assert_mem i32 p1+OBJ_TICK == ${GTICK}
set OUT_META ${OUTD}\${CASE}_game.json
include mbtl_meta.gcs
capture_window ${OUTD}\${CASE}_game.png
capture ${OUTD}\${CASE}_game_bb.png
key_tap F2 3 10
wait_frames 6
capture_window ${OUTD}\${CASE}_game_im.png
key_tap F2 3 10
wait_frames 6
# render-match2: MBTL-IM's 'Hide the characters' toggle proved unreliable under gamecap (2026-10-14 runs 1-4: the
# hidden state did not follow the key), so the plate hides P1/P2 by their draw-alpha override instead.
# plate B: P1/P2 draw-alpha override held at 0 (obj+0x648 alpha while obj+0x654 > 0, Sq_SetDrawAlpha)
hold u8 p1+OBJ_ALPHA_OVR 0
hold i32 p1+OBJ_ALPHA_OVR_ON 9999
hold u8 p2+OBJ_ALPHA_OVR 0
hold i32 p2+OBJ_ALPHA_OVR_ON 9999
wait_frames 8
capture ${OUTD}\${CASE}_game_plate_b0.png
key_tap F6 3 10
wait_frames 8
peek i32 p1+OBJ_TICK tick_plate_b
capture ${OUTD}\${CASE}_game_plate_bb.png
capture_window ${OUTD}\${CASE}_game_plate.png
unhold p1+OBJ_ALPHA_OVR
unhold p1+OBJ_ALPHA_OVR_ON
unhold p2+OBJ_ALPHA_OVR
unhold p2+OBJ_ALPHA_OVR_ON
# end the override (the game counts +0x654 down; leaving 9999 would hide P1/P2 in the next case)
poke i32 p1+OBJ_ALPHA_OVR_ON 0
poke i32 p2+OBJ_ALPHA_OVR_ON 0
poke u8 p1+OBJ_ALPHA_OVR 255
poke u8 p2+OBJ_ALPHA_OVR 255
wait_frames 4
key_tap F5 3 10
wait_frames 4
freeze
