# MBTL v2: idle control (chr001 pattern 0 frame 0) and the MBTL cases of chr001
include ../games/mbtl.gcs
let P1CHR 1
let P2CHR 1
# render-match2: MBTL-IM stage bloom off (screen post-process halo around bright sprites; restored at quit)
ini_set MBTL-IM/MBTL_IM.ini Stages BloomStrength 0
include ../games/mbtl_to_training.gcs
set OUTD C:\dev\hantei-chan\tools\gamecap\captures\v2\nobloom
set NSTEPS 1

set CASE mbtl_ctrl_chr001_p0f0
set PAT 0
set SETFRAME 0
set FRAME 0
set GTICK 1
include ../games/mbtl_v2_case_plate.gcs

set CASE mbtl_flipV_chr001_p157f2
set PAT 157
set SETFRAME 2
set FRAME 2
set GTICK 1
include ../games/mbtl_v2_case_plate.gcs
quit
