# render-match2: MBTL-IM's 'Hide the characters' toggle proved unreliable under gamecap (2026-10-14 runs 1-4: the
# hidden state did not follow the key), so the plate hides P1/P2 by their draw-alpha override instead.
# plate B: P1/P2 draw-alpha override held at 0 (obj+0x648 alpha while obj+0x654 > 0, Sq_SetDrawAlpha)
hold u8 p1+OBJ_ALPHA_OVR 0
hold i32 p1+OBJ_ALPHA_OVR_ON 9999
hold u8 p2+OBJ_ALPHA_OVR 0
hold i32 p2+OBJ_ALPHA_OVR_ON 9999
wait_frames 8
