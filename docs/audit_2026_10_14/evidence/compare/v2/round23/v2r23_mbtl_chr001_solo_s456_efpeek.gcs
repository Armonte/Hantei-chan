# render-match23 (2026-10-16): v2r19_mbtl_chr001_solo_s456_stagehold.gcs (stage anime held, _sa) plus one peek of the
# live objects at the game shot, plate_b0 and plate_bb: g_ObjectListCount 0xCAAD0C, the g_ObjectList 0xCAAD04 entries
# (8 bytes: obj ptr, flags) and the first 12 g_EffectPool 0xCCE700 slots (stride 0x868, in-use u8 at +0x864; pattern
# +0x1C, frame +0x20, tick +0x30). MBTL IDB names. Pattern 157 frame 2 has EF type 1 no 158 (Han6_EF_Dispatch 0x582452
# -> EffectPool_AllocSlot 0x42CAE0). Shots in captures/v2/r23 (suffix _sa23).
include ../games/mbtl.gcs
sym g_BattleHudFader 0xAFC3C8
sym g_BattleStageSel 0xAFC04C
sym g_CurStageIndex 0xA2E47C
sym g_StageAnimFrame 0xA300A0
file_put ../round10/chr001_solo21_s456.pat MBTL-IM/Mods/data/chr001/chr001.pat
let STAGE 21
let P1CHR 1
let P2CHR 1
ini_set MBTL-IM/MBTL_IM.ini Stages BloomStrength 0
include ../games/mbtl_to_training_stage.gcs
hold i32 g_StageAnimFrame 0
hold i32 [g_BattleHudFader]+8 2
hold i32 [g_BattleHudFader]+16 0
hold i32 [g_BattleHudFader]+20 0
step 4
set OUTD C:\dev\hantei-chan\tools\gamecap\captures\v2\r23
set NSTEPS 1
set CASE mbtl_flipV_chr001_p157f2_solo_s456_sa23
set PAT 157
set SETFRAME 2
set FRAME 2
set GTICK 1
peek i32 g_StageAnimFrame anim_before
include ../games/mbtl.gcs
# MBTL v2 full-frame capture of one case (after mbtl_to_training.gcs, which leaves the game frozen by gamecap).
# MBTL-IM's own Pause (F5) / Next frame (F6) / hitbox overlay (F2), pressed with gamecap's virtual keys: the agent
# patches only the MBTL-IM proxy's GetAsyncKeyState/GetForegroundWindow imports (no focus change, no global input).
# MBTL-IM pauses by suppressing ticks, so MBTL's catch-up timer never runs a burst of updates (the drift of the old
# gamecap-freeze method). Shots: capture_window (PrintWindow of our HWND), clean and then with the hitbox overlay.
# Vars: CASE PAT SETFRAME FRAME GTICK NSTEPS OUTD
# render-match2: same-session backdrop plate. MBTL-IM "Hide the characters" (rebound to F9 by the case file, plain
# key so no Fn chord) toggled while still paused on the asserted frame -> ${CASE}_game_plate.png (+ _bb).
unfreeze
wait_frames 30
key_tap F5 3 10
wait_frames 10
peek i32 p1+OBJ_TICK tick_paused_a
wait_frames 10
peek i32 p1+OBJ_TICK tick_paused_b
call Object_SetPatternFrame ecx=p1 edx=${PAT} ${SETFRAME}
wait_frames 4
peek i32 p1+OBJ_PATTERN pat_after_set
peek i32 p1+OBJ_FRAME frame_after_set
peek i32 p1+OBJ_TICK tick_after_set
include ../games/mbtl_v2_steps_${NSTEPS}.gcs
wait_frames 6
peek i32 p1+OBJ_PATTERN pat_s
peek i32 p1+OBJ_FRAME frame_s
peek i32 p1+OBJ_TICK tick_s
assert_mem i32 p1+OBJ_PATTERN == ${PAT}
assert_mem i32 p1+OBJ_FRAME == ${FRAME}
assert_mem i32 p1+OBJ_TICK == ${GTICK}
set OUT_META ${OUTD}\${CASE}_game.json
include mbtl_meta.gcs
peek i32 img(0xCAAD0C) game_objlist_count
peek i32 img(0x364AB04) game_efpool_cursor
peek u8 img(0xC7BE60) game_charashadow_rt_on
peek u32 [img(0xCAAD04)]+0 game_ol0_ptr
