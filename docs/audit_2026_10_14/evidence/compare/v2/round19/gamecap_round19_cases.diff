+++ b/tools/gamecap/round19/run_round19.sh
@@ -0,0 +1,12 @@
+#!/bin/bash
+# render-match19: the three stage-anim-held MBTL captures, one game at a time through run.sh's lock.
+# Retries a case while another agent's game is still running (run.sh refuses to start then).
+D=/mnt/c/dev/hantei-chan/tools/gamecap
+for c in ${CASES:-v2r19_mbtl_chr001_solo_s8_stagehold v2r19_mbtl_chr001_solo_s456_stagehold v2r19_mbtl_chr001_stagehold}; do
+  for try in $(seq 1 60); do
+    "$D/run.sh" "$D/cases/$c.gcs" > "$D/round19/run_$c.log" 2>&1; rc=$?
+    grep -q "a game is already running" "$D/round19/run_$c.log" || break
+    sleep 20
+  done
+  echo "$c rc=$rc"
+done
